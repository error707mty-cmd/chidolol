type TabId = "trabajo" | "casual";

function formatTime(date: Date) {
  return date.toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit" });
}

function renderMarkdown(text: string) {
  const lines = text.split("\n");
  const elements: JSX.Element[] = [];
  let i = 0;

  const renderInline = (line: string, key: string) => {
    const parts: (string | JSX.Element)[] = [];
    let remaining = line;
    let idx = 0;
    const pattern = /(\*\*[^*]+\*\*|\*[^*]+\*|`[^`]+`)/g;
    let lastIndex = 0;
    let match;
    while ((match = pattern.exec(remaining)) !== null) {
      if (match.index > lastIndex) parts.push(remaining.slice(lastIndex, match.index));
      const raw = match[0];
      if (raw.startsWith("**")) parts.push(<strong key={`${key}-b-${idx++}`}>{raw.slice(2, -2)}</strong>);
      else if (raw.startsWith("*")) parts.push(<em key={`${key}-i-${idx++}`}>{raw.slice(1, -1)}</em>);
      else if (raw.startsWith("`")) parts.push(<code key={`${key}-c-${idx++}`} className="ai-inline-code">{raw.slice(1, -1)}</code>);
      lastIndex = match.index + raw.length;
    }
    if (lastIndex < remaining.length) parts.push(remaining.slice(lastIndex));
    return parts;
  };

  while (i < lines.length) {
    const line = lines[i];
    const key = `line-${i}`;
    if (!line.trim()) {
      elements.push(<div key={key} style={{ height: "0.4em" }} />);
    } else if (line.startsWith("### ")) {
      elements.push(<h3 key={key} className="ai-md-h3">{line.slice(4)}</h3>);
    } else if (line.startsWith("## ")) {
      elements.push(<h2 key={key} className="ai-md-h2">{line.slice(3)}</h2>);
    } else if (line.startsWith("# ")) {
      elements.push(<h1 key={key} className="ai-md-h1">{line.slice(2)}</h1>);
    } else if (line.startsWith("- ") || line.startsWith("• ")) {
      elements.push(
        <div key={key} className="ai-md-li">
          <span className="ai-md-bullet">•</span>
          <span>{renderInline(line.slice(2), key)}</span>
        </div>
      );
    } else if (/^\d+\.\s/.test(line)) {
      const num = line.match(/^(\d+)\./)?.[1] ?? "1";
      elements.push(
        <div key={key} className="ai-md-li">
          <span className="ai-md-bullet">{num}.</span>
          <span>{renderInline(line.replace(/^\d+\.\s/, ""), key)}</span>
        </div>
      );
    } else if (line.startsWith("```")) {
      const codeLines: string[] = [];
      i++;
      while (i < lines.length && !lines[i].startsWith("```")) {
        codeLines.push(lines[i]);
        i++;
      }
      elements.push(
        <pre key={key} className="ai-code-block">
          <code>{codeLines.join("\n")}</code>
        </pre>
      );
    } else {
      elements.push(<p key={key} className="ai-md-p">{renderInline(line, key)}</p>);
    }
    i++;
  }
  return elements;
}

const MEMORY_KEY_TRABAJO = "error707-ai-memory-trabajo";
const MEMORY_KEY_CASUAL = "error707-ai-memory-casual";
const MAX_MEMORY = 60;

const WELCOME_TRABAJO: Message = {
  role: "assistant",
  content: "Hola. Soy **ERROR** — el asistente IA de ERROR707 Studio.\n\nTengo acceso completo a esta plataforma: código fuente, base de datos, usuarios, configuración del servidor IA y comandos de sistema. Puedo leer, escribir y ejecutar.\n\n¿En qué trabajamos hoy?",
  timestamp: new Date(),
};

const WELCOME_CASUAL: Message = {
  role: "assistant",
  content: "Qué onda. Estoy aquí para lo que necesites — hablar, brainstorming, ideas, lo que sea.\n\nEsta pestaña es más relajada. Sin comandos de sistema ni código, solo conversación. ¿De qué platicamos?",
  timestamp: new Date(),
};

function loadMemory(key: string, welcome: Message): Message[] {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return [welcome];
    const parsed = JSON.parse(raw) as Array<{ role: string; content: string; timestamp?: string; toolCalls?: { name: string; input: unknown }[] }>;
    if (!Array.isArray(parsed) || parsed.length === 0) return [welcome];
    return parsed.map((m) => ({
      role: m.role as "user" | "assistant",
      content: m.content,
      timestamp: m.timestamp ? new Date(m.timestamp) : undefined,
      toolCalls: m.toolCalls,
    }));
  } catch {
    return [welcome];
  }
}

function saveMemory(key: string, msgs: Message[]) {
  try {
    const toSave = msgs.slice(-MAX_MEMORY).map((m) => ({
      role: m.role,
      content: m.content,
      timestamp: m.timestamp?.toISOString(),
      toolCalls: m.toolCalls,
    }));
    localStorage.setItem(key, JSON.stringify(toSave));
  } catch { /* storage full */ }
}

// ── Chat panel compartido ──────────────────────────────────────────────
interface ChatPanelProps {
  messages: Message[];
  setMessages: React.Dispatch<React.SetStateAction<Message[]>>;
  loading: boolean;
  setLoading: React.Dispatch<React.SetStateAction<boolean>>;
  activeTools: string[];
  setActiveTools: React.Dispatch<React.SetStateAction<string[]>>;
  token: string | null;
  memoryKey: string;
  isCasual?: boolean;
}

function ChatPanel({
  messages, setMessages, loading, setLoading,
  activeTools, setActiveTools, token, memoryKey, isCasual = false
}: ChatPanelProps) {
  const [input, setInput] = useState("");
  const bottomRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const abortRef = useRef<AbortController | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [pendingImage, setPendingImage] = useState<{ base64: string; mediaType: string; preview: string } | null>(null);

  useEffect(() => {
    if (messages.length > 0) saveMemory(memoryKey, messages);
  }, [messages, memoryKey]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, activeTools]);

  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (!file.type.startsWith("image/")) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const dataUrl = ev.target?.result as string;
      const base64 = dataUrl.split(",")[1];
      setPendingImage({ base64, mediaType: file.type, preview: dataUrl });
    };
    reader.readAsDataURL(file);
    e.target.value = "";
  };

  const removePendingImage = () => setPendingImage(null);

  const sendMessage = useCallback(async (text: string) => {
    if ((!text.trim() && !pendingImage) || loading) return;

    let msgContent: string | (TextBlock | ImageBlock)[];
    let imagePreview: string | undefined;

    if (pendingImage) {
      const blocks: (TextBlock | ImageBlock)[] = [];
      if (text.trim()) blocks.push({ type: "text", text });
      blocks.push({
        type: "image",
        source: { type: "base64", media_type: pendingImage.mediaType, data: pendingImage.base64 },
      });
      msgContent = blocks;
      imagePreview = pendingImage.preview;
      setPendingImage(null);
    } else {
      msgContent = text;
    }

    const userMsg: Message = { role: "user", content: msgContent, imagePreview, timestamp: new Date() };
    const history = [...messages, userMsg];
    setMessages(history);
    setInput("");
    setLoading(true);
    setActiveTools([]);

    const assistantMsg: Message = { role: "assistant", content: "", isStreaming: true, timestamp: new Date() };
    setMessages([...history, assistantMsg]);
    abortRef.current = new AbortController();

    try {
      const endpoint = isCasual ? `${API_BASE}/admin/chat/casual` : `${API_BASE}/admin/chat`;
      const resp = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ messages: history.map((m) => ({ role: m.role, content: m.content })) }),
        signal: abortRef.current.signal,
      });

      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

      const reader = resp.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let fullContent = "";
      let toolCallsForMsg: { name: string; input: unknown }[] = [];

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const eventChunks = buffer.split("\n\n");
        buffer = eventChunks.pop() ?? "";

        for (const chunk of eventChunks) {
          const dataLine = chunk.startsWith("data: ") ? chunk.slice(6) : null;
          if (!dataLine) continue;
          try {
            const evt = JSON.parse(dataLine);
            if (evt.content) {
              fullContent += evt.content;
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.content = fullContent;
                last.isStreaming = true;
                next[next.length - 1] = last;
                return next;
              });
            }
            if (evt.tool_calls) {
              toolCallsForMsg = [...toolCallsForMsg, ...evt.tool_calls];
              setActiveTools(evt.tool_calls.map((t: any) => t.name));
            }
            if (evt.thinking) setActiveTools(["thinking"]);
            if (evt.done) {
              setActiveTools([]);
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.isStreaming = false;
                if (toolCallsForMsg.length) last.toolCalls = toolCallsForMsg;
                next[next.length - 1] = last;
                return next;
              });
            }
            if (evt.error) {
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.content = "❌ Ocurrió un error al procesar tu mensaje.";
                last.isStreaming = false;
                next[next.length - 1] = last;
                return next;
              });
            }
          } catch { /* ignore */ }
        }
      }
    } catch (err: any) {
      if (err.name === "AbortError") {
        setMessages((prev) => {
          const next = [...prev];
          const last = { ...next[next.length - 1] };
          last.content = last.content || "_(mensaje cancelado)_";
          last.isStreaming = false;
          return next;
        });
      } else {
        setMessages((prev) => {
          const next = [...prev];
          next[next.length - 1] = { role: "assistant", content: "❌ Error de conexión. Intenta de nuevo.", timestamp: new Date() };
          return next;
        });
      }
    } finally {
      setLoading(false);
      setActiveTools([]);
      inputRef.current?.focus();
    }
  }, [messages, loading, token, isCasual, pendingImage]);

  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(input); }
  };

  const stopGeneration = () => abortRef.current?.abort();

  return (
    <div className="aia-chat">
      {/* Messages */}
      <div className="aia-messages">
        {messages.map((msg, idx) => (
          <div key={idx} className={`aia-msg aia-msg--${msg.role}`}>
            {msg.role === "assistant" && (
              <div className="aia-avatar aia-avatar--bot">✦</div>
            )}
            <div className="aia-msg-content">
              {msg.toolCalls && msg.toolCalls.length > 0 && (
                <div className="aia-tools-used">
                  {msg.toolCalls.map((tc, ti) => (
                    <div key={ti} className="aia-tool-badge">
                      <span>{TOOL_ICONS[tc.name] ?? "⚡"}</span>
                      <span>{TOOL_LABELS[tc.name] ?? tc.name}</span>
                    </div>
                  ))}
                </div>
              )}
              <div className={`aia-bubble aia-bubble--${msg.role}`}>
                {msg.role === "assistant" ? (
                  <div className="aia-bubble-text">
                    {renderMarkdown(typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("\n"))}
                    {msg.isStreaming && <span className="ai-cursor" />}
                  </div>
                ) : (
                  <div className="aia-bubble-user-content">
                    {msg.imagePreview && (
                      <img src={msg.imagePreview} className="aia-msg-image" alt="imagen adjunta" />
                    )}
                    {(typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("")) && (
                      <p className="aia-bubble-text aia-bubble-text--user">
                        {typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("")}
                      </p>
                    )}
                  </div>
                )}
              </div>
              {msg.timestamp && (
                <div className={`aia-timestamp aia-timestamp--${msg.role}`}>
                  {formatTime(msg.timestamp)}
                </div>
              )}
            </div>
            {msg.role === "user" && (
              <div className="aia-avatar aia-avatar--user">U</div>
            )}
          </div>
        ))}

        {activeTools.length > 0 && (
          <div className="aia-msg aia-msg--assistant">
            <div className="aia-avatar aia-avatar--bot aia-avatar--pulse">✦</div>
            <div className="aia-msg-content">
              <div className="aia-thinking">
                <div className="aia-think-dots">
                  <span /><span /><span />
                </div>
                <div className="aia-think-info">
                  <span className="aia-think-icon">
                    {activeTools[0] === "thinking" ? "🧠" : (TOOL_ICONS[activeTools[0]] ?? "⚡")}
                  </span>
                  <span className="aia-think-label">
                    {activeTools[0] === "thinking" ? "Razonando..." : (TOOL_LABELS[activeTools[0]] ?? activeTools[0])}
                  </span>
                </div>
              </div>
            </div>
          </div>
        )}

        <div ref={bottomRef} />
      </div>

      {/* Input area */}
      <div className="aia-input-area">
        {pendingImage && (
          <div className="aia-img-preview-wrap">
            <img src={pendingImage.preview} className="aia-img-preview" alt="imagen a enviar" />
            <button className="aia-img-remove" onClick={removePendingImage} title="Quitar imagen">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        )}
        <div className="aia-input-wrap">
          <textarea
            ref={inputRef}
            className="aia-input"
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={handleKeyDown}
            placeholder={pendingImage ? "Agrega un mensaje (opcional)..." : isCasual ? "Escribe algo..." : "Escribe tu mensaje aquí..."}
            rows={3}
            disabled={loading}
          />
          <div className="aia-input-footer">
            <div className="aia-input-left">
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                style={{ display: "none" }}
                onChange={handleImageSelect}
              />
              <button
                className={`aia-img-btn${pendingImage ? " aia-img-btn--active" : ""}`}
                onClick={() => fileInputRef.current?.click()}
                disabled={loading}
                title="Adjuntar imagen"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                {pendingImage ? "Imagen lista" : "Imagen"}
              </button>
              <span className="aia-input-hint">
                <kbd>Enter</kbd> enviar &nbsp;·&nbsp; <kbd>Shift+Enter</kbd> nueva línea
              </span>
            </div>
            <div className="aia-input-btns">
              {loading && (
                <button className="aia-stop-btn" onClick={stopGeneration}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="6" y="6" width="12" height="12" rx="2"/>
                  </svg>
                  Detener
                </button>
              )}
              <button
                className="aia-send-btn"
                onClick={() => sendMessage(input)}
                disabled={loading || (!input.trim() && !pendingImage)}
              >
                {loading ? (
                  <span className="aia-spinner" />
                ) : (
                  <>
                    Enviar
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                      <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function AdminAsistente() {
  const { token } = useAuth();
  const [activeTab, setActiveTab] = useState<TabId>("trabajo");

  // Estado independiente para cada pestaña
  const [msgsTrabajo, setMsgsTrabajo] = useState<Message[]>(() => loadMemory(MEMORY_KEY_TRABAJO, WELCOME_TRABAJO));
  const [msgsCasual, setMsgsCasual] = useState<Message[]>(() => loadMemory(MEMORY_KEY_CASUAL, WELCOME_CASUAL));
  const [loadingTrabajo, setLoadingTrabajo] = useState(false);
  const [loadingCasual, setLoadingCasual] = useState(false);
  const [toolsTrabajo, setToolsTrabajo] = useState<string[]>([]);
  const [toolsCasual, setToolsCasual] = useState<string[]>([]);

  const memoryCountTrabajo = msgsTrabajo.filter(m => m.role === "user").length;
  const memoryCountCasual = msgsCasual.filter(m => m.role === "user").length;

  const clearTrabajo = () => {
    setMsgsTrabajo([{ ...WELCOME_TRABAJO, timestamp: new Date() }]);
    setToolsTrabajo([]);
    localStorage.removeItem(MEMORY_KEY_TRABAJO);
  };
  const clearCasual = () => {
    setMsgsCasual([{ ...WELCOME_CASUAL, timestamp: new Date() }]);
    setToolsCasual([]);
    localStorage.removeItem(MEMORY_KEY_CASUAL);
  };

  const isLoading = activeTab === "trabajo" ? loadingTrabajo : loadingCasual;

  return (
    <div className="aia-root">
      <div className="aia-orb aia-orb1" />
      <div className="aia-orb aia-orb2" />

      {/* Header */}
      <header className="adm-header">
        <div style={{ display: "flex", alignItems: "center", gap: "0.75rem" }}>
          <Link href="/" className="adm-nav-link" style={{ fontSize: "12px" }}>← Inicio</Link>
          <span className="adm-header-sep">|</span>
          <span style={{ fontSize: "13px", fontWeight: 700, color: "#a78bfa" }}>Admin</span>
        </div>
        <nav className="adm-nav">
          <Link href="/admin" className="adm-nav-link">Panel</Link>
          <Link href="/admin/membresias" className="adm-nav-link">Membresías</Link>
          <Link href="/admin/usuarios" className="adm-nav-link">Usuarios</Link>
          <Link href="/admin/ia" className="adm-nav-link">IA</Link>
          <span className="adm-nav-link adm-nav-link--active">Asistente</span>
          <Link href="/pliegos" className="adm-nav-link">← Mis trabajos</Link>
        </nav>
      </header>

      {/* Main layout */}
      <main className="aia-main">

        {/* ── Sidebar — solo visible en pestaña Trabajo ── */}
        {activeTab === "trabajo" && (
          <aside className="aia-sidebar">
            {/* Brand */}
            <div className="aia-brand">
              <div className="aia-brand-icon">
                <span className="aia-brand-bot">✦</span>
              </div>
              <div>
                <div className="aia-brand-name">Asistente IA</div>
                <div className="aia-brand-model">Claude Sonnet 4</div>
              </div>
              <div className="aia-status-dot" title="En línea" />
            </div>

            {/* Stats strip */}
            <div className="aia-stats-strip">
              <div className="aia-stat-item">
                <span className="aia-stat-num">{memoryCountTrabajo}</span>
                <span className="aia-stat-lbl">enviados</span>
              </div>
              <div className="aia-stat-sep" />
              <div className="aia-stat-item">
                <span className="aia-stat-num">{msgsTrabajo.length}</span>
                <span className="aia-stat-lbl">total</span>
              </div>
              <div className="aia-stat-sep" />
              <div className="aia-stat-item">
                <span className="aia-stat-num" style={{ color: loadingTrabajo ? "#f97316" : "#22c55e" }}>
                  {loadingTrabajo ? "⚡" : "●"}
                </span>
                <span className="aia-stat-lbl">{loadingTrabajo ? "activo" : "listo"}</span>
              </div>
            </div>

            {/* Quick actions */}
            <div className="aia-section">
              <div className="aia-section-label">
                <span className="aia-section-bar" />
                Acciones rápidas
              </div>
              <div className="aia-quick-grid">
                {QUICK_ACTIONS.map((qa) => (
                  <button
                    key={qa.label}
                    className="aia-quick-btn"
                    onClick={() => {
                      // Trigger send in trabajo tab
                      const fakeInput = document.querySelector(".aia-input") as HTMLTextAreaElement;
                      if (fakeInput) fakeInput.value = qa.prompt;
                      // Dispatch through the chat panel via a custom event
                      window.dispatchEvent(new CustomEvent("aia-quick-send", { detail: qa.prompt }));
                    }}
                    disabled={loadingTrabajo}
                    title={qa.label}
                  >
                    <span className="aia-quick-icon">{qa.icon}</span>
                    <span className="aia-quick-label">{qa.label}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Capabilities */}
            <div className="aia-section">
              <div className="aia-section-label">
                <span className="aia-section-bar" />
                Capacidades
              </div>
              <div className="aia-caps">
                {CAPABILITIES.map((cap) => (
                  <div key={cap.label} className="aia-cap">
                    <span className="aia-cap-icon">{cap.icon}</span>
                    <span className="aia-cap-label">{cap.label}</span>
                    <span className="aia-cap-check">✓</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Clear button */}
            <button className="aia-clear-btn" onClick={clearTrabajo}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                <polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/>
              </svg>
              Limpiar conversación
            </button>
          </aside>
        )}

        {/* ── Panel derecho: tabs + chat ── */}
        <div className="aia-right-panel">

          {/* Tabs */}
          <div className="aia-tabs">
            <button
              className={`aia-tab${activeTab === "trabajo" ? " aia-tab--active" : ""}`}
              onClick={() => setActiveTab("trabajo")}
              disabled={isLoading}
            >
              <span className="aia-tab-icon">⚡</span>
              Trabajo
              {loadingTrabajo && <span className="aia-tab-pulse" />}
            </button>
            <button
              className={`aia-tab${activeTab === "casual" ? " aia-tab--active" : ""}`}
              onClick={() => setActiveTab("casual")}
              disabled={isLoading}
            >
              <span className="aia-tab-icon">💬</span>
              Casual
              {loadingCasual && <span className="aia-tab-pulse" />}
            </button>

            {/* Clear button casual tab */}
            {activeTab === "casual" && (
              <button className="aia-tab-clear" onClick={clearCasual}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                  <polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/>
                </svg>
                Limpiar
              </button>
            )}

            <div className="aia-tabs-spacer" />

            {activeTab === "casual" && (
              <div className="aia-casual-badge">
                <span>💬</span> Modo conversacional
              </div>
            )}
          </div>

          {/* Chat panels — uno por pestaña, ambos montados, solo se muestra el activo */}
          <div style={{ display: activeTab === "trabajo" ? "contents" : "none" }}>
            <ChatPanelTrabajo
              messages={msgsTrabajo}
              setMessages={setMsgsTrabajo}
              loading={loadingTrabajo}
              setLoading={setLoadingTrabajo}
              activeTools={toolsTrabajo}
              setActiveTools={setToolsTrabajo}
              token={token}
            />
          </div>
          <div style={{ display: activeTab === "casual" ? "contents" : "none" }}>
            <ChatPanel
              messages={msgsCasual}
              setMessages={setMsgsCasual}
              loading={loadingCasual}
              setLoading={setLoadingCasual}
              activeTools={toolsCasual}
              setActiveTools={setToolsCasual}
              token={token}
              memoryKey={MEMORY_KEY_CASUAL}
              isCasual={true}
            />
          </div>
        </div>
      </main>
    </div>
  );
}

// Versión de ChatPanel para Trabajo que escucha el evento de acciones rápidas
function ChatPanelTrabajo(props: Omit<ChatPanelProps, "memoryKey" | "isCasual">) {
  const sendRef = useRef<((text: string) => void) | null>(null);

  useEffect(() => {
    const handler = (e: Event) => {
      const prompt = (e as CustomEvent).detail as string;
      if (sendRef.current) sendRef.current(prompt);
    };
    window.addEventListener("aia-quick-send", handler);
    return () => window.removeEventListener("aia-quick-send", handler);
  }, []);

  return (
    <ChatPanelInner
      {...props}
      memoryKey={MEMORY_KEY_TRABAJO}
      isCasual={false}
      onSendReady={(fn) => { sendRef.current = fn; }}
    />
  );
}

interface ChatPanelInnerProps extends ChatPanelProps {
  onSendReady?: (fn: (text: string) => void) => void;
}

function ChatPanelInner({
  messages, setMessages, loading, setLoading,
  activeTools, setActiveTools, token, memoryKey, isCasual = false,
  onSendReady
}: ChatPanelInnerProps) {
  const [input, setInput] = useState("");
  const bottomRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const abortRef = useRef<AbortController | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [pendingImage, setPendingImage] = useState<{ base64: string; mediaType: string; preview: string } | null>(null);

  useEffect(() => {
    if (messages.length > 0) saveMemory(memoryKey, messages);
  }, [messages, memoryKey]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, activeTools]);

  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (!file.type.startsWith("image/")) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const dataUrl = ev.target?.result as string;
      const base64 = dataUrl.split(",")[1];
      setPendingImage({ base64, mediaType: file.type, preview: dataUrl });
    };
    reader.readAsDataURL(file);
    e.target.value = "";
  };

  const removePendingImage = () => setPendingImage(null);

  const sendMessage = useCallback(async (text: string, image?: { base64: string; mediaType: string; preview: string } | null) => {
    const img = image !== undefined ? image : pendingImage;
    if ((!text.trim() && !img) || loading) return;

    let msgContent: string | (TextBlock | ImageBlock)[];
    let imagePreview: string | undefined;

    if (img) {
      const blocks: (TextBlock | ImageBlock)[] = [];
      if (text.trim()) blocks.push({ type: "text", text });
      blocks.push({
        type: "image",
        source: { type: "base64", media_type: img.mediaType, data: img.base64 },
      });
      msgContent = blocks;
      imagePreview = img.preview;
      if (image === undefined) setPendingImage(null);
    } else {
      msgContent = text;
    }

    const userMsg: Message = { role: "user", content: msgContent, imagePreview, timestamp: new Date() };
    const history = [...messages, userMsg];
    setMessages(history);
    setInput("");
    setLoading(true);
    setActiveTools([]);

    const assistantMsg: Message = { role: "assistant", content: "", isStreaming: true, timestamp: new Date() };
    setMessages([...history, assistantMsg]);
    abortRef.current = new AbortController();

    try {
      const endpoint = isCasual ? `${API_BASE}/admin/chat/casual` : `${API_BASE}/admin/chat`;
      const resp = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ messages: history.map((m) => ({ role: m.role, content: m.content })) }),
        signal: abortRef.current.signal,
      });

      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

      const reader = resp.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let fullContent = "";
      let toolCallsForMsg: { name: string; input: unknown }[] = [];

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const eventChunks = buffer.split("\n\n");
        buffer = eventChunks.pop() ?? "";

        for (const chunk of eventChunks) {
          const dataLine = chunk.startsWith("data: ") ? chunk.slice(6) : null;
          if (!dataLine) continue;
          try {
            const evt = JSON.parse(dataLine);
            if (evt.content) {
              fullContent += evt.content;
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.content = fullContent;
                last.isStreaming = true;
                next[next.length - 1] = last;
                return next;
              });
            }
            if (evt.tool_calls) {
              toolCallsForMsg = [...toolCallsForMsg, ...evt.tool_calls];
              setActiveTools(evt.tool_calls.map((t: any) => t.name));
            }
            if (evt.thinking) setActiveTools(["thinking"]);
            if (evt.done) {
              setActiveTools([]);
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.isStreaming = false;
                if (toolCallsForMsg.length) last.toolCalls = toolCallsForMsg;
                next[next.length - 1] = last;
                return next;
              });
            }
            if (evt.error) {
              setMessages((prev) => {
                const next = [...prev];
                const last = { ...next[next.length - 1] };
                last.content = "❌ Ocurrió un error al procesar tu mensaje.";
                last.isStreaming = false;
                next[next.length - 1] = last;
                return next;
              });
            }
          } catch { /* ignore */ }
        }
      }
    } catch (err: any) {
      if (err.name === "AbortError") {
        setMessages((prev) => {
          const next = [...prev];
          const last = { ...next[next.length - 1] };
          last.content = last.content || "_(mensaje cancelado)_";
          last.isStreaming = false;
          return next;
        });
      } else {
        setMessages((prev) => {
          const next = [...prev];
          next[next.length - 1] = { role: "assistant", content: "❌ Error de conexión. Intenta de nuevo.", timestamp: new Date() };
          return next;
        });
      }
    } finally {
      setLoading(false);
      setActiveTools([]);
      inputRef.current?.focus();
    }
  }, [messages, loading, token, isCasual, pendingImage]);

  // Exponer sendMessage al padre para acciones rápidas
  useEffect(() => {
    if (onSendReady) onSendReady((text) => sendMessage(text, null));
  }, [sendMessage, onSendReady]);

  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(input); }
  };

  const stopGeneration = () => abortRef.current?.abort();

  return (
    <div className="aia-chat">
      <div className="aia-messages">
        {messages.map((msg, idx) => (
          <div key={idx} className={`aia-msg aia-msg--${msg.role}`}>
            {msg.role === "assistant" && (
              <div className="aia-avatar aia-avatar--bot">✦</div>
            )}
            <div className="aia-msg-content">
              {msg.toolCalls && msg.toolCalls.length > 0 && (
                <div className="aia-tools-used">
                  {msg.toolCalls.map((tc, ti) => (
                    <div key={ti} className="aia-tool-badge">
                      <span>{TOOL_ICONS[tc.name] ?? "⚡"}</span>
                      <span>{TOOL_LABELS[tc.name] ?? tc.name}</span>
                    </div>
                  ))}
                </div>
              )}
              <div className={`aia-bubble aia-bubble--${msg.role}`}>
                {msg.role === "assistant" ? (
                  <div className="aia-bubble-text">
                    {renderMarkdown(typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("\n"))}
                    {msg.isStreaming && <span className="ai-cursor" />}
                  </div>
                ) : (
                  <div className="aia-bubble-user-content">
                    {msg.imagePreview && (
                      <img src={msg.imagePreview} className="aia-msg-image" alt="imagen adjunta" />
                    )}
                    {(typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("")) && (
                      <p className="aia-bubble-text aia-bubble-text--user">
                        {typeof msg.content === "string" ? msg.content : msg.content.filter((b): b is TextBlock => b.type === "text").map(b => b.text).join("")}
                      </p>
                    )}
                  </div>
                )}
              </div>
              {msg.timestamp && (
                <div className={`aia-timestamp aia-timestamp--${msg.role}`}>
                  {formatTime(msg.timestamp)}
                </div>
              )}
            </div>
            {msg.role === "user" && (
              <div className="aia-avatar aia-avatar--user">U</div>
            )}
          </div>
        ))}

        {activeTools.length > 0 && (
          <div className="aia-msg aia-msg--assistant">
            <div className="aia-avatar aia-avatar--bot aia-avatar--pulse">✦</div>
            <div className="aia-msg-content">
              <div className="aia-thinking">
                <div className="aia-think-dots">
                  <span /><span /><span />
                </div>
                <div className="aia-think-info">
                  <span className="aia-think-icon">
                    {activeTools[0] === "thinking" ? "🧠" : (TOOL_ICONS[activeTools[0]] ?? "⚡")}
                  </span>
                  <span className="aia-think-label">
                    {activeTools[0] === "thinking" ? "Razonando..." : (TOOL_LABELS[activeTools[0]] ?? activeTools[0])}
                  </span>
                </div>
              </div>
            </div>
          </div>
        )}

        <div ref={bottomRef} />
      </div>

      <div className="aia-input-area">
        {pendingImage && (
          <div className="aia-img-preview-wrap">
            <img src={pendingImage.preview} className="aia-img-preview" alt="imagen a enviar" />
            <button className="aia-img-remove" onClick={removePendingImage} title="Quitar imagen">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        )}
        <div className="aia-input-wrap">
          <textarea
            ref={inputRef}
            className="aia-input"
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={handleKeyDown}
            placeholder={pendingImage ? "Agrega un mensaje (opcional)..." : isCasual ? "Escribe algo..." : "Escribe tu mensaje aquí..."}
            rows={3}
            disabled={loading}
          />
          <div className="aia-input-footer">
            <div className="aia-input-left">
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                style={{ display: "none" }}
                onChange={handleImageSelect}
              />
              <button
                className={`aia-img-btn${pendingImage ? " aia-img-btn--active" : ""}`}
                onClick={() => fileInputRef.current?.click()}
                disabled={loading}
                title="Adjuntar imagen"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                {pendingImage ? "Imagen lista" : "Imagen"}
              </button>
              <span className="aia-input-hint">
                <kbd>Enter</kbd> enviar &nbsp;·&nbsp; <kbd>Shift+Enter</kbd> nueva línea
              </span>
            </div>
            <div className="aia-input-btns">
              {loading && (
                <button className="aia-stop-btn" onClick={stopGeneration}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="6" y="6" width="12" height="12" rx="2"/>
                  </svg>
                  Detener
                </button>
              )}
              <button
                className="aia-send-btn"
                onClick={() => sendMessage(input)}
                disabled={loading || (!input.trim() && !pendingImage)}
              >
                {loading ? (
                  <span className="aia-spinner" />
                ) : (
                  <>
                    Enviar
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                      <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
